  "description": "午间岛 - 一套代码编译四端：Android App / iOS App / HarmonyOS(鸿蒙) / 微信小程序",
  "scripts": {
    "dev:h5": "node scripts/vendor-map.mjs && uni dev",
    "build:h5": "node scripts/vendor-map.mjs && uni build",
    "dev:mp-weixin": "node scripts/vendor-map.mjs && uni dev -p mp-weixin",
    "build:mp-weixin": "node scripts/vendor-map.mjs && uni build -p mp-weixin",
    "dev:app": "node scripts/vendor-map.mjs && uni dev -p app",
    "build:app": "node scripts/vendor-map.mjs && uni build -p app",
    "dev:app-harmony": "node scripts/vendor-map.mjs && uni dev -p app-harmony",
    "build:app-harmony": "node scripts/vendor-map.mjs && uni build -p app-harmony",
    "test": "node --test tests/*.test.mjs",
    "vendor:map": "node scripts/vendor-map.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4060620250520001",
    "@dcloudio/uni-components": "3.0.0-4060620250520001",
